# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=

# Discord Application ID (from Discord Developer Portal)
DISCORD_CLIENT_ID=

# PostgreSQL Database URL (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/internship_jobs?schema=public"

# Optional: GitHub Token for GitHub Jobs API (optional, for higher rate limits)
GITHUB_TOKEN=

# Optional: Bot configuration
NODE_ENV=development
LOG_LEVEL=info
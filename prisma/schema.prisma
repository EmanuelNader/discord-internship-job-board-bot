generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  description String
  url         String   @unique
  source      String
  postedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, postedAt])
  @@index([title])
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  location  String?
  userId    String
  guildId   String?
  results   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([guildId, createdAt])
}